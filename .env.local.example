# Supabase Project Configuration Example for SkillSwap
# Copy this file to .env.local and replace with your real Supabase credentials:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local Postgres Database URL (connected and active via Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
